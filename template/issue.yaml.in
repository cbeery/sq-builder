title: Stan Quarterly
abbr: SQ
issue: ${issue_name}
subtitle: Compiled by Curt, for Stan
colophon: All content reprinted without permission. Oh well.

# The SQ wordmark is ALWAYS supplied artwork, never set in type. It is
# Mazzard H Black with a distinctive angled Q tail; a substitute grotesque
# is visibly wrong. Required — a missing file is a hard build error.
# Copy the transparent PNG in from the previous issue.
mark:
  image: images/sq-mark.png

# ONE finished image per cover. The build never assembles a composite: its
# jobs are to fill the bleed, honour `focus`, and draw the wordmark and
# stamp over the top. Supply roughly ${ideal_px} px
# (${ideal_in} in at 300 ppi) so nothing is lost to the crop.
# focus: center | top | bottom | left | right | "50% 30%"
cover:
  image: images/cover.jpg
  focus: center
back_cover:
  image: images/back-cover.jpg
  focus: center

# Verified against the printed Summer 2026 issue as ordered from Mixam.
# Changing these means a new order spec — see docs/MIXAM-RUNBOOK.md.
trim:
  width_pt: ${trim_w}
  height_pt: ${trim_h}
bleed_pt: ${bleed}
quiet_pt: ${quiet}

margins_pt:
  top: ${margin_top}
  bottom: ${margin_bottom}
  inside: ${margin_inside}
  outside: ${margin_outside}

# Preflight FAILs on any embedded font family that is not one of the five
# roles sq.css declares, because a silent substitution passes every other
# font check cleanly. If a family really is wanted, name it here and the
# FAIL becomes an acknowledged WARN. Matching is on the family stem, so
# "Times New Roman" covers the weight and width variants too.
# fonts:
#   accept:
#     - Times New Roman

theme:
  accent: "#2FC79A"
  ink: "#111111"
  muted: "#6E6E6E"
  rule: "#D8D8D8"

# The colophon page — how the issue is made. Always the last printed
# leaf, on a right-hand page, and part of the fixed shape of every issue:
# the build pads forward to land it there. Omit this block entirely and
# the page is not produced. `sections` overrides the standard text;
# `notes` adds a paragraph specific to this issue.
about:
  heading: Stan Quarterly
  subheading: How we made this thing
  builder_url: github.com/cbeery/sq-builder
  notes_heading: About ${issue_name}
  # Write this once the articles are in — it names what is in the issue,
  # so it cannot be written first. Preflight FAILs while it says TODO.
  notes: >-
    TODO
  # Set pdf_url once the PDF is hosted somewhere and a QR code appears
  # with the instructions below. Leave it out and neither is drawn.
  # pdf_url: https://example.com/sq-issue.pdf
  qr_instructions: >-
    **To read this on your iPad:** open the Camera app, point it at the
    square above, and tap the notification that slides down from the top.
    The whole issue will open in Safari. Tap the share button and choose
    **Books** to keep a copy on the iPad for good.

# Order here is the order in the magazine and in the contents.
# `sq add` appends to this list.
articles:
